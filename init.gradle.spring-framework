allprojects {
  repositories {
    mavenLocal()
    if (System.getProperty('useNexusMirror') == 'true') {
      // Remove gradle plugin portal from dependency repositories and replace with internal Nexus mirror
      all { ArtifactRepository repo ->
        if (repo instanceof MavenArtifactRepository && repo.url.host == 'plugins.gradle.org') {
          remove repo
        }
      }
      maven {
        url 'http://nexus-service.nexus.svc.cluster.local:8081/repository/maven-public'
        allowInsecureProtocol = true
      }
    }
  }
  buildscript {
    repositories {
      if (System.getProperty('useNexusMirror') == 'true') {
        all { ArtifactRepository repo ->
          if (repo instanceof MavenArtifactRepository && repo.url.host == 'plugins.gradle.org') {
            remove repo
          }
        }
        maven {
          url 'http://nexus-service.nexus.svc.cluster.local:8081/repository/maven-public'
          allowInsecureProtocol = true
        }
      }
    }
  }
  configurations.all {
    // Override the version of every org.eclipse.jetty* coordinate to the version under test.
    // We use eachDependency/useVersion rather than dependencySubstitution/useTarget so the
    // dependency keeps its original selector and the BOM (jetty-bom / jetty-ee11-bom) constraint
    // edges remain intact. Spring Boot's checkRuntimeClasspathForUnconstrainedDirectDependencies
    // task matches direct dependencies against constraints by group:module; useTarget replaces the
    // selector and drops that match, making managed modules look unconstrained and failing the build.
    resolutionStrategy.eachDependency { details ->
      def group = details.requested.group
      if (group.startsWith("org.eclipse.jetty")) { // && !group.equals('org.eclipse.jetty.websocket')) {
        def module = details.requested.name
        def version = (module == 'jetty-reactive-httpclient') ? System.getProperty("jetty.reactive.httpclient","4.0.9") : System.getProperty("jetty.version","12.0.17")
        details.useVersion version
      }
    }
  }
  tasks.withType(Test).configureEach {
    exclude '**/**AvailabilityProbesAutoConfigurationTests.class'  // Excludes AvailabilityProbesAutoConfigurationTests
    exclude '**/**ManagementPortAndPathWithAntPatcherSampleActuatorApplicationTests.class'  // Excludes ManagementPortAndPathWithAntPatcherSampleActuatorApplicationTests
    exclude '**/**JerseyFilterApplicationTests.class'  // Excludes JerseyFilterApplicationTests
    exclude '**/**SampleSecureWebFluxApplicationTests.class'  // Excludes SampleSecureWebFluxApplicationTests
    ignoreFailures = true
  }
}
